<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
    <Product Id="*"
             Name="ExaWallpaper"
             Language="1033"
             Version="$(var.ProductVersion)"
             Manufacturer="Exa Ecosystem"
             UpgradeCode="A3B7E1F2-4C5D-6E7F-8A9B-0C1D2E3F4A5B">

        <Package InstallerVersion="500"
                 Compressed="yes"
                 InstallScope="perMachine"
                 Description="ExaWallpaper - Native Live Video Wallpaper"
                 Comments="Ultra-lightweight, 100% native live video wallpaper engine for Windows" />

        <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
        <MediaTemplate EmbedCab="yes" />

        <Icon Id="AppIcon" SourceFile="$(var.SourceDir)\Resources\app.ico" />
        <Property Id="ARPPRODUCTICON" Value="AppIcon" />
        <Property Id="ARPHELPLINK" Value="https://github.com/eka-dev-ecosystem/exawallpaper" />

        <!-- Directory Structure -->
        <Directory Id="TARGETDIR" Name="SourceDir">
            <Directory Id="ProgramFiles64Folder">
                <Directory Id="INSTALLFOLDER" Name="ExaWallpaper">
                    <Directory Id="SAMPLESFOLDER" Name="sample-wallpapers" />
                </Directory>
            </Directory>
            <Directory Id="ProgramMenuFolder">
                <Directory Id="ApplicationProgramsFolder" Name="ExaWallpaper" />
            </Directory>
        </Directory>

        <!-- Components -->
        <DirectoryRef Id="INSTALLFOLDER">
            <Component Id="MainExecutable" Guid="B4C8E2F3-5D6E-7F8A-9B0C-1D2E3F4A5B6C" Win64="yes">
                <File Id="ExaWallpaperEXE"
                      Source="$(var.PublishDir)\ExaWallpaper.exe"
                      KeyPath="yes" />
            </Component>
        </DirectoryRef>

        <DirectoryRef Id="SAMPLESFOLDER">
            <Component Id="SampleWallpapers" Guid="D6E7F8A9-B0C1-2D3E-4F5A-6B7C8D9E0F1A" Win64="yes">
                <File Id="GojoSatoruMP4"
                      Source="$(var.SourceDir)\sample-wallpapers\gojo_satoru_live.mp4"
                      KeyPath="yes" />
                <File Id="YaeMikoMP4"
                      Source="$(var.SourceDir)\sample-wallpapers\yae_miko_live.mp4" />
                <File Id="SakurajimaMaiMP4"
                      Source="$(var.SourceDir)\sample-wallpapers\sakurajima_mai_live.mp4" />
            </Component>
        </DirectoryRef>

        <!-- Start Menu Shortcut -->
        <DirectoryRef Id="ApplicationProgramsFolder">
            <Component Id="ApplicationShortcut" Guid="C5D9F3A4-6E7F-8A9B-0C1D-2E3F4A5B6C7D">
                <Shortcut Id="ApplicationStartMenuShortcut"
                          Name="ExaWallpaper"
                          Description="Launch ExaWallpaper"
                          Target="[INSTALLFOLDER]ExaWallpaper.exe"
                          WorkingDirectory="INSTALLFOLDER"
                          Icon="AppIcon" />
                <RemoveFolder Id="CleanUpShortCut" Directory="ApplicationProgramsFolder" On="uninstall" />
                <RegistryValue Root="HKCU"
                               Key="Software\ExaEcosystem\ExaWallpaper"
                               Name="installed"
                               Type="integer"
                               Value="1"
                               KeyPath="yes" />
            </Component>
        </DirectoryRef>

        <!-- Features -->
        <Feature Id="ProductFeature" Title="ExaWallpaper" Level="1">
            <ComponentRef Id="MainExecutable" />
            <ComponentRef Id="SampleWallpapers" />
            <ComponentRef Id="ApplicationShortcut" />
        </Feature>

        <!-- UI -->
        <UIRef Id="WixUI_Minimal" />
        <WixVariable Id="WixUILicenseRtf" Value="$(var.SourceDir)\installer\license.rtf" />
    </Product>
</Wix>
